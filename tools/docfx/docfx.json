{
  "metadata": [
    {
      "src": [
        {
          "src": "../../src/dotnet",
          "files": [
            "Mocassin.Core/bin/Release/net11.0/Mocassin.Core.dll",
            "Mocassin.Symmetry/bin/Release/net11.0/Mocassin.Symmetry.dll",
            "Mocassin.Compilation/bin/Release/net11.0/Mocassin.Compilation.dll",
            "Mocassin.Contracts/bin/Release/net11.0/Mocassin.Contracts.dll",
            "Mocassin.Packages/bin/Release/net11.0/Mocassin.Packages.dll",
            "Mocassin.Results/bin/Release/net11.0/Mocassin.Results.dll",
            "Mocassin.App.ViewModels/bin/Release/net11.0/Mocassin.App.ViewModels.dll",
            "Mocassin.App.Views/bin/Release/net11.0/Mocassin.App.Views.dll",
            "Mocassin.Rendering/bin/Release/net11.0/Mocassin.Rendering.dll"
          ],
          "exclude": [
            "**/obj/**"
          ]
        }
      ],
      "dest": "../../artifacts/docfx/api",
      "properties": {
        "TargetFramework": "net11.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/*.yml"
        ],
        "src": "../../artifacts/docfx"
      }
    ],
    "dest": "../../artifacts/docfx",
    "globalMetadata": {
      "_appTitle": "MOCASSIN .NET API",
      "_appFooter": "MOCASSIN reimplementation contributors"
    },
    "template": [
      "default",
      "modern"
    ],
    "overwrite": []
  }
}
