<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Documents.Project"
             x:Class="Mocassin.App.Views.Documents.Project.ProjectJsonView"
             x:DataType="vm:ProjectJsonViewModel">
  <Grid RowDefinitions="Auto,*" Margin="12">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Content="Copy JSON" Command="{Binding CopyJsonCommand}" />
      <TextBlock Text="Read-only canonical project JSON"
                 Classes="caption"
                 VerticalAlignment="Center" />
    </StackPanel>
    <TextBox Grid.Row="1"
             Text="{Binding JsonText, Mode=OneWay}"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             FontFamily="monospace"
             VerticalContentAlignment="Top" />
  </Grid>
</UserControl>
