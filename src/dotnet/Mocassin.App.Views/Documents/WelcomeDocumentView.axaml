<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Documents"
             xmlns:projects="using:Mocassin.App.ViewModels.Projects"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Documents.WelcomeDocumentView"
             x:DataType="vm:WelcomeDocumentViewModel">
  <StackPanel VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Spacing="16"
              MaxWidth="520"
              Background="{DynamicResource Mocassin.WorkspaceBackground}">
    <TextBlock Text="Welcome to MOCASSIN"
               FontSize="{DynamicResource Mocassin.DisplayFontSize}"
               LineHeight="{DynamicResource Mocassin.DisplayLineHeight}"
               FontWeight="SemiBold"
               Foreground="{DynamicResource Mocassin.ForegroundStrongBrush}"
               HorizontalAlignment="Center" />
    <TextBlock Text="Monte Carlo for Solid State Ionics"
               FontSize="{DynamicResource Mocassin.SubtitleFontSize}"
               LineHeight="{DynamicResource Mocassin.SubtitleLineHeight}"
               Foreground="{DynamicResource Mocassin.ForegroundMutedBrush}"
               HorizontalAlignment="Center" />
    <TextBlock Text="Create a project from a starter or open an existing .mocprj file."
               TextWrapping="Wrap"
               TextAlignment="Center"
               Margin="0,12,0,0" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Button Content="New project" Command="{Binding NewProjectCommand}" />
      <Button Content="Open project" Command="{Binding OpenProjectCommand}" />
    </StackPanel>
    <Button Content="Keyboard shortcuts"
            Command="{Binding ShowShortcutsCommand}"
            HorizontalAlignment="Center" />

    <StackPanel Spacing="4" Margin="0,12,0,0">
      <TextBlock Text="Recent projects"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Mocassin.ForegroundStrongBrush}"
                 HorizontalAlignment="Center" />
      <ItemsControl ItemsSource="{Binding RecentProjects.Entries}" MaxWidth="560"
                    automation:AutomationProperties.Name="Recent projects">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="projects:RecentProjectViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4" Margin="0,2">
              <TextBlock Text="{Binding Path}"
                         Classes="caption"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="Missing"
                         Foreground="{DynamicResource Mocassin.ErrorForeground}"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsMissing}" />
              <Button Grid.Column="2" Classes="compact" Content="Open" Command="{Binding OpenCommand}" />
              <Button Grid.Column="3" Classes="compact" Content="Remove" Command="{Binding RemoveCommand}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
