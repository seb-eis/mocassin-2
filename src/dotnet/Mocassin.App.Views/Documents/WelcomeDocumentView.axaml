<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Documents"
             x:Class="Mocassin.App.Views.Documents.WelcomeDocumentView"
             x:DataType="vm:WelcomeDocumentViewModel">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="520">
    <TextBlock Text="Welcome to MOCASSIN" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
    <TextBlock Text="Monte Carlo for Solid State Ionics"
               FontSize="16"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
               HorizontalAlignment="Center" />
    <TextBlock Text="Create a project from a starter or open an existing .mocprj file."
               TextWrapping="Wrap"
               TextAlignment="Center"
               Margin="0,12,0,0" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Button Content="New project" Command="{Binding NewProjectCommand}" />
      <Button Content="Open project" Command="{Binding OpenProjectCommand}" />
    </StackPanel>
    <Button Content="Keyboard shortcuts"
            Command="{Binding ShowShortcutsCommand}"
            HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
