<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Consoles"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Consoles.ApplicationConsoleView"
             x:DataType="vm:ConsoleChannelViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,4">
      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" />
      <TextBox Grid.Column="1"
               automation:AutomationProperties.Name="Application console filter"
               Margin="12,0"
               PlaceholderText="Filter the application console"
               Text="{Binding FilterText}" />
      <Button Grid.Column="2" Content="Clear"
                automation:AutomationProperties.Name="Clear application console" Command="{Binding ClearCommand}" />
    </Grid>
    <ListBox Grid.Row="1"
             automation:AutomationProperties.Name="Application console entries"
             ItemsSource="{Binding VisibleEntries}"
             Background="Transparent"
             BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ConsoleEntryViewModel">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <TextBlock Text="{Binding TimestampUtc, StringFormat='{}{0:HH:mm:ss}'}"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,8,0" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Severity}"
                       Width="80"
                       Margin="0,0,8,0" />
            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
