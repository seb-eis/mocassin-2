<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Consoles"
             xmlns:diagnostics="using:Mocassin.App.ViewModels.Diagnostics"
             xmlns:consoles="using:Mocassin.App.Views.Consoles"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Consoles.ConsoleView"
             x:DataType="vm:ConsoleViewModel">
  <TabControl x:Name="ConsoleTabs"
              automation:AutomationProperties.Name="Console tabs"
              ItemsSource="{Binding Channels}"
              SelectedItem="{Binding ActiveChannel, Mode=TwoWay}"
              TabStripPlacement="Top"
              KeyDown="OnTabsKeyDown">
    <TabControl.ItemTemplate>
      <DataTemplate x:DataType="vm:ConsoleChannelViewModel">
        <TextBlock Text="{Binding TabTitle}" />
      </DataTemplate>
    </TabControl.ItemTemplate>
    <TabControl.DataTemplates>
      <DataTemplate DataType="diagnostics:ProblemsChannelViewModel">
        <consoles:ProblemsView />
      </DataTemplate>
      <DataTemplate DataType="vm:ConsoleChannelViewModel">
        <consoles:ApplicationConsoleView />
      </DataTemplate>
    </TabControl.DataTemplates>
  </TabControl>
</UserControl>
