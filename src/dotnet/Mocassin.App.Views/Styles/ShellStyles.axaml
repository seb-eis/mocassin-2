<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Mocassin.BodyFontSize}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Padding" Value="{DynamicResource Mocassin.ControlPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Mocassin.ControlMinHeight}" />
    <Setter Property="Transitions" Value="{DynamicResource Mocassin.Transitions}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource Mocassin.ControlMinHeight}" />
    <Setter Property="Transitions" Value="{DynamicResource Mocassin.Transitions}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource Mocassin.ControlMinHeight}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="{DynamicResource Mocassin.ItemPadding}" />
  </Style>
  <Style Selector="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Mocassin.BorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Mocassin.BorderThickness}" />
  </Style>
  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
  </Style>
</Styles>
