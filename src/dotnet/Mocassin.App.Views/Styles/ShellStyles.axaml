<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Mocassin.BodyFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource Mocassin.BodyLineHeight}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource Mocassin.ForegroundMutedBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource Mocassin.CaptionFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource Mocassin.CaptionLineHeight}" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="Foreground" Value="{DynamicResource Mocassin.ForegroundStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Padding" Value="{DynamicResource Mocassin.ControlPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Mocassin.ControlMinHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mocassin.RadiusControl}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Mocassin.ControlBorderThickness}" />
    <Setter Property="Transitions" Value="{DynamicResource Mocassin.Transitions}" />
  </Style>
  <Style Selector="Button.compact">
    <Setter Property="Padding" Value="{DynamicResource Mocassin.CompactButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Mocassin.CompactButtonMinHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Mocassin.AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Mocassin.OnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mocassin.AccentBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Mocassin.CardBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Mocassin.ErrorForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mocassin.ErrorBorderBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource Mocassin.HoverBackground}" />
  </Style>
  <Style Selector="Button.danger:pressed">
    <Setter Property="Background" Value="{DynamicResource Mocassin.PressedBackground}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource Mocassin.ControlMinHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mocassin.RadiusControl}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Mocassin.ControlBorderThickness}" />
    <Setter Property="Transitions" Value="{DynamicResource Mocassin.Transitions}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Mocassin.AccentBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Mocassin.OnAccentBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource Mocassin.ControlMinHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mocassin.RadiusControl}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Mocassin.ControlBorderThickness}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="{DynamicResource Mocassin.ItemPadding}" />
  </Style>

  <!--
    Fluent captures TreeViewItemBackgroundSelected* in StaticResource aliases, and its header/chevron foreground
    does not follow the palette alias. These targeted selected-state styles are the delivery point for the fixed
    selected fill and text. They are styles, not a control template.
  -->
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Mocassin.SelectedBackground}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource Mocassin.SelectedBackground}" />
  </Style>
  <Style Selector="TreeViewItem:pressed:selected /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource Mocassin.SelectedBackground}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Mocassin.SelectedForeground}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ ToggleButton#PART_ExpandCollapseChevron /template/ Path#ChevronPath">
    <Setter Property="Fill" Value="{DynamicResource Mocassin.SelectedForeground}" />
  </Style>

  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource Mocassin.MenuBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Mocassin.ForegroundBrush}" />
    <Setter Property="MinHeight" Value="{DynamicResource Mocassin.MenuHeight}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="{DynamicResource Mocassin.BodyFontSize}" />
  </Style>

  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Mocassin.ForegroundBrush}" />
  </Style>
  <!--
    Stock Fluent TabItem: the header inset moves from the padded layout root to the content presenter so the
    selected pipe can span the tab. Only the top corners are rounded; the selected fill equals the content.
  -->
  <Style Selector="TabItem">
    <Setter Property="MinHeight" Value="{DynamicResource Mocassin.TabHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mocassin.RadiusTabTop}" />
    <Setter Property="FontSize" Value="{DynamicResource Mocassin.BodyFontSize}" />
    <Setter Property="FocusAdorner">
      <Template>
        <Border BorderBrush="{DynamicResource Mocassin.FocusBrush}"
                BorderThickness="{DynamicResource Mocassin.FocusThickness}"
                CornerRadius="{DynamicResource Mocassin.RadiusTabTop}" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Margin" Value="{DynamicResource TabItemHeaderMargin}" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="{DynamicResource Mocassin.TabIndicatorInset}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!--
    Scroll gutters. Fluent's auto-hiding scrollbar overlays the content, so the content is inset by the bar width
    plus a 4 px margin. ListBox and TreeView forward Padding to their internal items presenter.
  -->
  <Style Selector="ScrollViewer.scroll-gutter-right, ListBox.scroll-gutter-right, TreeView.scroll-gutter-right">
    <Setter Property="Padding" Value="{DynamicResource Mocassin.ScrollGutterRight}" />
  </Style>
  <Style Selector="ScrollViewer.scroll-gutter-bottom, ListBox.scroll-gutter-bottom, TreeView.scroll-gutter-bottom">
    <Setter Property="Padding" Value="{DynamicResource Mocassin.ScrollGutterBottom}" />
  </Style>
  <Style Selector="ScrollViewer.scroll-gutter-both, ListBox.scroll-gutter-both, TreeView.scroll-gutter-both">
    <Setter Property="Padding" Value="{DynamicResource Mocassin.ScrollGutterBoth}" />
  </Style>
  <Style Selector="TextBox.scroll-gutter-both /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="Padding" Value="{DynamicResource Mocassin.ScrollGutterBoth}" />
  </Style>
  <Style Selector="ComboBox /template/ ScrollViewer">
    <Setter Property="Padding" Value="{DynamicResource Mocassin.ScrollGutterRight}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.region-card">
    <Setter Property="Background" Value="{DynamicResource Mocassin.WorkspaceBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mocassin.BorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Mocassin.BorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mocassin.RadiusCard}" />
  </Style>
  <Style Selector="Border.overlay-card">
    <Setter Property="Background" Value="{DynamicResource Mocassin.CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mocassin.BorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Mocassin.BorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mocassin.RadiusCard}" />
    <Setter Property="Padding" Value="{DynamicResource Mocassin.CardPadding}" />
  </Style>
  <Style Selector="Border.banner-error">
    <Setter Property="Background" Value="{DynamicResource Mocassin.ErrorBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mocassin.ErrorBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Mocassin.BorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mocassin.RadiusControl}" />
  </Style>
  <Style Selector="Border.banner-success">
    <Setter Property="Background" Value="{DynamicResource Mocassin.SuccessBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mocassin.SuccessBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Mocassin.BorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mocassin.RadiusControl}" />
  </Style>
  <Style Selector="Border.banner-warning">
    <Setter Property="Background" Value="{DynamicResource Mocassin.WarningBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mocassin.WarningBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Mocassin.BorderThickness}" />
  </Style>
</Styles>
