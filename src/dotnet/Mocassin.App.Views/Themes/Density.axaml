<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:av="using:Avalonia">
  <av:Thickness x:Key="Mocassin.RegionGap">4</av:Thickness>
  <av:Thickness x:Key="Mocassin.RegionPadding">8</av:Thickness>
  <av:Thickness x:Key="Mocassin.RegionHeaderPadding">8,6</av:Thickness>
  <av:Thickness x:Key="Mocassin.CardPadding">12</av:Thickness>
  <av:Thickness x:Key="Mocassin.ControlPadding">4</av:Thickness>
  <av:Thickness x:Key="Mocassin.ItemPadding">2,1</av:Thickness>
  <av:Thickness x:Key="Mocassin.CompactButtonPadding">6,2</av:Thickness>
  <x:Double x:Key="Mocassin.ControlMinHeight">26</x:Double>
  <x:Double x:Key="Mocassin.CompactButtonMinHeight">22</x:Double>
  <x:Double x:Key="Mocassin.TabHeight">28</x:Double>
  <x:Double x:Key="Mocassin.MenuHeight">28</x:Double>
  <x:Double x:Key="Mocassin.StatusBarHeight">22</x:Double>
  <x:Double x:Key="TabItemMinHeight">28</x:Double>
  <av:Thickness x:Key="TabItemHeaderMargin">6,2</av:Thickness>
</ResourceDictionary>
