<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overlay="using:Mocassin.App.ViewModels.Dialogs"
             xmlns:dialogs="using:Mocassin.App.ViewModels.Dialogs.Requests"
             xmlns:dialogViews="using:Mocassin.App.Views.Dialogs"
             x:Class="Mocassin.App.Views.Dialogs.ErrorDialogView"
             x:DataType="overlay:ErrorDialogViewModel">
  <StackPanel Spacing="12">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource Mocassin.TitleFontSize}" LineHeight="{DynamicResource Mocassin.TitleLineHeight}" Foreground="{DynamicResource Mocassin.ForegroundStrongBrush}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <Expander Header="Details" IsVisible="{Binding HasDetails}">
      <ItemsControl ItemsSource="{Binding Details}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="dialogs:ErrorDialogDetail">
            <TextBlock Text="{Binding Code, StringFormat='{}{0}: '}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Close"
              Command="{Binding DismissCommand}"
              IsDefault="True"
              IsCancel="True"
              dialogViews:DialogFocus.InitialFocus="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
