<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overlay="using:Mocassin.App.ViewModels.Dialogs"
             xmlns:dialogs="using:Mocassin.App.Views.Dialogs"
             x:Class="Mocassin.App.Views.Dialogs.ChoiceDialogView"
             x:DataType="overlay:ChoiceDialogViewModel">
  <StackPanel Spacing="12">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource Mocassin.TitleFontSize}" LineHeight="{DynamicResource Mocassin.TitleLineHeight}" Foreground="{DynamicResource Mocassin.ForegroundStrongBrush}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <ListBox Classes="scroll-gutter-right"
             ItemsSource="{Binding Choices}"
             SelectedItem="{Binding SelectedChoice}"
             MinHeight="80"
             dialogs:DialogFocus.InitialFocus="True">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="overlay:DialogChoice">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Content="Continue" Command="{Binding ConfirmCommand}" Classes="accent" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
