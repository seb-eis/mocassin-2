<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overlay="using:Mocassin.App.ViewModels.Dialogs"
             x:Class="Mocassin.App.Views.Dialogs.ProgressDialogView"
             x:DataType="overlay:ProgressDialogViewModel">
  <StackPanel Spacing="12">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
    <ProgressBar Minimum="0" Maximum="1"
                 Value="{Binding Fraction, TargetNullValue=0}"
                 IsIndeterminate="{Binding IsIndeterminate}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Command="{Binding RequestCancelCommand}" IsVisible="{Binding IsCancelable}" />
    </StackPanel>
  </StackPanel>
</UserControl>
