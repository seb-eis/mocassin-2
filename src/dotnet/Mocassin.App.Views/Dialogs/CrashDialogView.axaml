<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overlay="using:Mocassin.App.ViewModels.Dialogs"
             xmlns:automation="using:Avalonia.Automation"
             xmlns:dialogs="using:Mocassin.App.Views.Dialogs"
             x:Class="Mocassin.App.Views.Dialogs.CrashDialogView"
             x:DataType="overlay:CrashDialogViewModel">
  <StackPanel Spacing="12">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding LogFilePath}" Classes="caption" TextWrapping="Wrap" />
    <Expander Header="Crash details" IsVisible="{Binding HasDetails}">
      <ScrollViewer MaxHeight="220">
        <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap" />
      </ScrollViewer>
    </Expander>
    <TextBlock Text="{Binding RecoveryStatus}"
               IsVisible="{Binding HasRecoveryStatus}"
               TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Write recovery files"
              Command="{Binding WriteRecoveryFilesCommand}"
              IsVisible="{Binding HasRecoverySnapshots}"
              automation:AutomationProperties.Name="Write recovery files"
              dialogs:DialogFocus.InitialFocus="True" />
      <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}"
              IsVisible="{Binding CanOpenLogFolder}" />
      <Button Content="Exit" Command="{Binding ExitCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
