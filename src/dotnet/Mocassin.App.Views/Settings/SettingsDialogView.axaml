<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Settings.Dialog"
             xmlns:automation="using:Avalonia.Automation"
             xmlns:settings="using:Mocassin.App.ViewModels.Settings"
             x:Class="Mocassin.App.Views.Settings.SettingsDialogView"
             x:DataType="vm:SettingsViewModel">
  <Grid Background="#66000000">
    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Width="680"
            MaxHeight="760"
            VerticalAlignment="Center"
            Padding="20">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" automation:AutomationProperties.Name="Settings" />
        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Text="Theme" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                             automation:AutomationProperties.Name="Theme" />
              <TextBlock Grid.Row="1" Text="Accent" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}"
                             automation:AutomationProperties.Name="Accent" Margin="0,6,0,0" />
              <TextBlock Grid.Row="2" Text="Density" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Densities}" SelectedItem="{Binding Density}"
                             automation:AutomationProperties.Name="Density" Margin="0,6,0,0" />
              <TextBlock Grid.Row="3" Text="Font scale" VerticalAlignment="Center" Margin="0,6,0,0" />
              <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                <Slider automation:AutomationProperties.Name="Font scale" Minimum="0.85" Maximum="1.5" TickFrequency="0.05" Value="{Binding FontScale}" />
                <TextBlock Grid.Column="1" Text="{Binding FontScale, StringFormat='{}{0:0.00}×'}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
              <TextBlock Grid.Row="4" Text="Log level" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"
                             automation:AutomationProperties.Name="Log level" Margin="0,6,0,0" />
              <TextBlock Grid.Row="5" Text="Culture" VerticalAlignment="Center" Margin="0,6,0,0" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="Invariant English (localization is deferred)" Classes="caption" Margin="0,6,0,0" />
              <TextBlock Grid.Row="6" Text="Paths" VerticalAlignment="Top" Margin="0,6,0,0" />
              <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,6,0,0">
                <TextBlock Text="{Binding SettingsPath}" Classes="caption" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DataDirectory}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
              <CheckBox automation:AutomationProperties.Name="High contrast" Content="High contrast" IsChecked="{Binding HighContrast}" />
              <CheckBox automation:AutomationProperties.Name="Reduce motion" Content="Reduce motion" IsChecked="{Binding ReduceMotion}" />
              <CheckBox automation:AutomationProperties.Name="Confirm before reloading an externally changed project" Content="Confirm before reloading an externally changed project" IsChecked="{Binding ConfirmOnExternalChange}" />
              <CheckBox automation:AutomationProperties.Name="Show the welcome document on a fresh start" Content="Show the welcome document on a fresh start" IsChecked="{Binding ShowWelcomeOnStart}" />
              <CheckBox automation:AutomationProperties.Name="Enable autosave" Content="Enable autosave" IsChecked="{Binding AutosaveEnabled}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Autosave interval (minutes)" VerticalAlignment="Center" />
                <TextBox Text="{Binding AutosaveIntervalMinutes}"
                         automation:AutomationProperties.Name="Autosave interval minutes"
                         Width="80" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Recent projects" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="Clear recent" Command="{Binding ClearRecentCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding RecentFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="settings:RecentFile">
                    <TextBlock Text="{Binding Path}" Classes="caption" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Open config folder" Command="{Binding OpenConfigFolderCommand}" />
              <Button Content="Clear logs and cache" Command="{Binding ClearLogsCommand}" />
            </StackPanel>

            <Border IsVisible="{Binding HasErrorMessage}"
                    Background="#FDECEA"
                    BorderBrush="#C62828"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
              <TextBlock Text="{Binding ErrorMessage}"
                         Foreground="#B71C1C"
                         TextWrapping="Wrap"
                         automation:AutomationProperties.Name="Settings error" />
            </Border>
            <Border IsVisible="{Binding HasStatusMessage}"
                    Background="#E8F5E9"
                    BorderBrush="#2E7D32"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
              <TextBlock Text="{Binding StatusMessage}"
                         TextWrapping="Wrap"
                         automation:AutomationProperties.Name="Settings status" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="Reset to defaults" Command="{Binding ResetCommand}" />
          <Button Content="Cancel" Command="{Binding CloseCommand}" IsCancel="True" />
          <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
