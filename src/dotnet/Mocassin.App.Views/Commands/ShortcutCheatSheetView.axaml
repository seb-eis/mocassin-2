<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Commands"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Commands.ShortcutCheatSheetView"
             x:DataType="vm:ShortcutCheatSheetViewModel">
  <Grid Background="{DynamicResource Mocassin.OverlayScrim}"
        automation:AutomationProperties.Name="Keyboard shortcuts">
    <Border Classes="overlay-card"
            Width="640"
            MaxHeight="620"
            VerticalAlignment="Center">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="Keyboard shortcuts"
                   FontSize="{DynamicResource Mocassin.TitleFontSize}"
                   LineHeight="{DynamicResource Mocassin.TitleLineHeight}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Mocassin.ForegroundStrongBrush}" />
        <ScrollViewer Grid.Row="1" Classes="scroll-gutter-right">
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShortcutGroup">
                <StackPanel Spacing="4" Margin="0,0,0,12">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding Commands}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ShellCommand">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Title}" />
                          <TextBlock Grid.Column="1" Text="{Binding GestureText}" Classes="caption" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="2"
                x:Name="CloseButton"
                Content="Close"
                Command="{Binding CloseCommand}"
                Classes="accent"
                IsDefault="True"
                IsCancel="True"
                HorizontalAlignment="Right" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
