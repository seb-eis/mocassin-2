<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Editors.Structure"
             xmlns:space="using:Mocassin.Symmetry.SpaceGroups"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Editors.Structure.SpaceGroupEditorView"
             x:DataType="vm:SpaceGroupEditorViewModel">
  <StackPanel Spacing="8" Margin="14">
    <TextBlock Text="Space group" FontWeight="SemiBold" FontSize="{DynamicResource Mocassin.TitleFontSize}" />

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="Search by number, Hermann–Mauguin, Hall symbol, crystal system, axis, or origin"
               automation:AutomationProperties.Name="Space-group search" />
      <TextBlock Grid.Column="1"
                 Text="{Binding SelectedSettingText}"
                 VerticalAlignment="Center"
                 Classes="caption" />
    </Grid>

    <ListBox ItemsSource="{Binding Results}"
             SelectedItem="{Binding SelectedSetting, Mode=TwoWay}"
             Height="150"
             automation:AutomationProperties.Name="Space-group results">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="space:SpaceGroupSetting">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Number}" />
            <TextBlock Text="—" />
            <TextBlock Text="{Binding HermannMauguin}" />
            <TextBlock Text="(" />
            <TextBlock Text="{Binding CrystalSystem}" />
            <TextBlock Text="," />
            <TextBlock Text="{Binding Axis}" />
            <TextBlock Text="," />
            <TextBlock Text="{Binding Origin}" />
            <TextBlock Text=") · Hall" />
            <TextBlock Text="{Binding HallSymbol}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
      <TextBlock Text="Settings" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1"
                ItemsSource="{Binding GroupSettings}"
                SelectedItem="{Binding SelectedSetting, Mode=TwoWay}"
                automation:AutomationProperties.Name="Space-group axis and origin settings">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="space:SpaceGroupSetting">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding Axis}" />
              <TextBlock Text="/" />
              <TextBlock Text="{Binding Origin}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <Border Background="{DynamicResource Mocassin.CardBackground}"
            BorderBrush="{DynamicResource Mocassin.BorderBrush}"
            BorderThickness="{DynamicResource Mocassin.BorderThickness}"
            CornerRadius="{DynamicResource Mocassin.RadiusCard}"
            Padding="10">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="10">
        <TextBlock Text="Operations" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="{Binding OperationCount}" />
        <TextBlock Grid.Row="1" Text="General multiplicity" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GeneralMultiplicity}" />
        <TextBlock Grid.Row="2" Text="Crystal system" FontWeight="SemiBold" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CrystalSystemText}" />
        <TextBlock Grid.Row="3" Text="Current" FontWeight="SemiBold" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentSettingText}" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <ListBox ItemsSource="{Binding Operations}"
             Height="170"
             automation:AutomationProperties.Name="Space-group operations">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SpaceGroupOperationViewModel">
          <Grid ColumnDefinitions="36,190,150,*" ColumnSpacing="6">
            <TextBlock Text="{Binding Number}" />
            <TextBlock Grid.Column="1" Text="{Binding MatrixText}" />
            <TextBlock Grid.Column="2" Text="{Binding TranslationText}" />
            <TextBlock Grid.Column="3" Text="{Binding HumanReadableText}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Text="{Binding CompatibilityText}" FontWeight="SemiBold"
               automation:AutomationProperties.Name="Space-group compatibility" />
    <ListBox ItemsSource="{Binding Orbits}"
             MaxHeight="110"
             automation:AutomationProperties.Name="Space-group orbit preview">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SpaceGroupOrbitPreviewViewModel">
          <Grid ColumnDefinitions="160,150,*">
            <TextBlock Text="{Binding SiteName}" />
            <TextBlock Grid.Column="1" Text="{Binding ChangeText}" />
            <TextBlock Grid.Column="2"
                       Text="overlap"
                       IsVisible="{Binding HasOverlap}"
                       Foreground="{DynamicResource Mocassin.ErrorForeground}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Text="{Binding DiagnosticsText}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Mocassin.ForegroundMutedBrush}"
               automation:AutomationProperties.Name="Space-group diagnostics" />
    <TextBlock Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               Foreground="{DynamicResource Mocassin.ErrorForeground}"
               TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Apply" Command="{Binding ApplyCommand}"
              automation:AutomationProperties.Name="Apply space group" />
      <Button Content="Cancel" Command="{Binding CancelCommand}"
              automation:AutomationProperties.Name="Cancel space-group change" />
      <TextBlock Text="Changing the space group is one undo entry."
                 VerticalAlignment="Center"
                 Classes="caption" />
    </StackPanel>
  </StackPanel>
</UserControl>
