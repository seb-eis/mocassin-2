<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Editors.Structure"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Editors.Structure.CellParametersView"
             x:DataType="vm:CellParameterEditorViewModel">
  <StackPanel Spacing="8" Margin="14">
    <TextBlock Text="Cell parameters" FontWeight="SemiBold" FontSize="{DynamicResource Mocassin.TitleFontSize}" />
    <StackPanel Orientation="Horizontal" Spacing="4">
      <TextBlock Text="Crystal system:" Classes="caption" />
      <TextBlock Text="{Binding CrystalSystemText}" Classes="caption" />
      <TextBlock Text="· axis" Classes="caption" />
      <TextBlock Text="{Binding AxisText}" Classes="caption" />
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Fields}" automation:AutomationProperties.Name="Cell parameter fields">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CellFieldViewModel">
          <Grid ColumnDefinitions="40,140,36,*" ColumnSpacing="6" Margin="0,2">
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding Text, Mode=TwoWay}"
                     IsEnabled="{Binding IsInputEnabled}"
                     automation:AutomationProperties.Name="{Binding Label}" />
            <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
              <TextBlock Text="{Binding LockReason}"
                         Classes="caption"
                         IsVisible="{Binding IsLocked}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Error}"
                         Foreground="{DynamicResource Mocassin.ErrorForeground}"
                         IsVisible="{Binding HasError}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Background="{DynamicResource Mocassin.CardBackground}"
            BorderBrush="{DynamicResource Mocassin.BorderBrush}"
            BorderThickness="{DynamicResource Mocassin.BorderThickness}"
            CornerRadius="{DynamicResource Mocassin.RadiusCard}"
            Padding="10">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="10">
        <TextBlock Text="Cell vectors" FontWeight="SemiBold" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Text="{Binding VectorsText}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="Volume" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VolumeText}" />
        <TextBlock Grid.Row="2" Text="Geometry" FontWeight="SemiBold" VerticalAlignment="Top" />
        <TextBlock Grid.Row="2" Grid.Column="1"
                   Text="{Binding DiagnosticsText}"
                   TextWrapping="Wrap"
                   automation:AutomationProperties.Name="Cell geometry diagnostics" />
      </Grid>
    </Border>

    <Border Background="{DynamicResource Mocassin.WarningBackground}"
            BorderBrush="{DynamicResource Mocassin.WarningBorderBrush}"
            BorderThickness="{DynamicResource Mocassin.BorderThickness}"
            Padding="10"
            IsVisible="{Binding HasPendingReset}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding PendingResetText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Content="Confirm" Command="{Binding ConfirmResetCommand}"
                automation:AutomationProperties.Name="Confirm cell reset" />
        <Button Content="Cancel" Command="{Binding CancelResetCommand}"
                automation:AutomationProperties.Name="Cancel cell reset" />
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding ConflictMessage}"
               IsVisible="{Binding HasConflict}"
               Foreground="{DynamicResource Mocassin.WarningForeground}"
               TextWrapping="Wrap" />
    <TextBlock Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               Foreground="{DynamicResource Mocassin.ErrorForeground}"
               TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Apply" Command="{Binding ApplyCommand}"
              automation:AutomationProperties.Name="Apply cell parameters" />
      <Button Content="Revert" Command="{Binding RevertCommand}"
              automation:AutomationProperties.Name="Revert cell parameters" />
      <Button Content="Reset to cubic" Command="{Binding RequestResetToCubicCommand}"
              automation:AutomationProperties.Name="Reset cell to cubic" />
      <Button Content="Reset to defaults" Command="{Binding RequestResetToDefaultsCommand}"
              automation:AutomationProperties.Name="Reset cell to defaults" />
    </StackPanel>
  </StackPanel>
</UserControl>
