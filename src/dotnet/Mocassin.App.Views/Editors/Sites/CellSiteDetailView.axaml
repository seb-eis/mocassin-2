<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Editors.Sites"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Editors.Sites.CellSiteDetailView"
             x:CompileBindings="False"
             x:DataType="vm:CellSiteDetailViewModel">
  <ScrollViewer Classes="scroll-gutter-right" Background="{DynamicResource Mocassin.WorkspaceBackground}">
    <StackPanel Spacing="10" Margin="14">
      <TextBlock Text="Cell site" FontWeight="SemiBold" FontSize="{DynamicResource Mocassin.TitleFontSize}" />

      <Grid ColumnDefinitions="110,140,36,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1"
                 x:Name="name"
                 Text="{Binding Name, Mode=TwoWay}"
                 IsEnabled="{Binding CanEditForm}"
                 automation:AutomationProperties.Name="Site name" />

        <TextBlock Grid.Row="1" Text="Fractional a" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 x:Name="fractional"
                 Text="{Binding FieldA, Mode=TwoWay}"
                 IsEnabled="{Binding CanEditForm}"
                 automation:AutomationProperties.Name="Site fractional a" />
        <TextBlock Grid.Row="2" Text="Fractional b" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1"
                 Text="{Binding FieldB, Mode=TwoWay}"
                 IsEnabled="{Binding CanEditForm}"
                 automation:AutomationProperties.Name="Site fractional b" />
        <TextBlock Grid.Row="3" Text="Fractional c" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding FieldC, Mode=TwoWay}"
                 IsEnabled="{Binding CanEditForm}"
                 automation:AutomationProperties.Name="Site fractional c" />

        <TextBlock Grid.Row="4" Text="Stability" VerticalAlignment="Center" />
        <ComboBox Grid.Row="4" Grid.Column="1"
                  ItemsSource="{Binding StabilityChoices}"
                  SelectedItem="{Binding Stability, Mode=TwoWay}"
                  IsEnabled="{Binding CanEditForm}"
                  automation:AutomationProperties.Name="Site stability" />
      </Grid>

      <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="4">
        <TextBlock Text="Particle set" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBox Text="{Binding ParticleSetPicker.SearchText, Mode=TwoWay}"
                   PlaceholderText="Search particle sets"
                   IsEnabled="{Binding CanEditForm}"
                   automation:AutomationProperties.Name="Particle-set search" />
          <ComboBox x:Name="particleSetId"
                    ItemsSource="{Binding ParticleSetPicker.FilteredOptions}"
                    SelectedItem="{Binding ParticleSetPicker.Selected, Mode=TwoWay}"
                    IsEnabled="{Binding CanEditForm}"
                    automation:AutomationProperties.Name="Site particle set">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="10">
        <TextBlock Text="Orbit size" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="{Binding OrbitSize}" />
        <TextBlock Grid.Row="1" Text="Multiplicity" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Multiplicity}" />
        <TextBlock Grid.Row="2" Text="Cartesian" FontWeight="SemiBold" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CartesianText}" TextWrapping="Wrap" />
      </Grid>

      <TextBlock Text="{Binding FieldError}"
                 IsVisible="{Binding HasFieldError}"
                 Foreground="{DynamicResource Mocassin.ErrorForeground}"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding DiagnosticsText}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource Mocassin.ForegroundMutedBrush}"
                 automation:AutomationProperties.Name="Site candidate diagnostics" />
      <Border Classes="banner-error"
              Padding="8"
              IsVisible="{Binding HasOverlap}">
        <TextBlock Text="The candidate overlaps another reference site (STR007); Apply is disabled."
                   TextWrapping="Wrap" />
      </Border>
      <Border Classes="banner-warning"
              Padding="8"
              IsVisible="{Binding HasStabilityWarning}">
        <TextBlock Text="{Binding StabilityWarning}" TextWrapping="Wrap" />
      </Border>
      <TextBlock Text="{Binding ConflictMessage}"
                 IsVisible="{Binding HasConflict}"
                 Foreground="{DynamicResource Mocassin.WarningForeground}"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding ErrorMessage}"
                 IsVisible="{Binding HasError}"
                 Foreground="{DynamicResource Mocassin.ErrorForeground}"
                 TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Apply" Command="{Binding ApplyCommand}"
                automation:AutomationProperties.Name="Apply cell site" />
        <Button Content="Revert" Command="{Binding RevertCommand}"
                automation:AutomationProperties.Name="Revert cell site" />
        <TextBlock Text="Inspector and Problems show the dependents."
                   VerticalAlignment="Center"
                   Classes="caption" />
      </StackPanel>

      <Border Background="{DynamicResource Mocassin.CardBackground}"
              BorderBrush="{DynamicResource Mocassin.BorderBrush}"
              BorderThickness="{DynamicResource Mocassin.BorderThickness}"
              CornerRadius="{DynamicResource Mocassin.RadiusCard}"
              Padding="10"
              IsVisible="{Binding HasDependents}">
        <StackPanel Spacing="6">
          <TextBlock Text="Dependents" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Dependents}"
                        automation:AutomationProperties.Name="Site dependents">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding DisplayName}" />
                    <TextBlock Text="{Binding Description}" Classes="caption" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="Go"
                          Command="{Binding DataContext.OpenDependentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          automation:AutomationProperties.Name="Navigate to dependent" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding EnergyDeleteText}" TextWrapping="Wrap" Classes="caption" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanDeleteEnergyOnly}">
            <Button Content="Delete site and energy references"
                    Command="{Binding RequestEnergyDeleteCommand}"
                    IsVisible="{Binding !HasPendingEnergyDelete}"
                    automation:AutomationProperties.Name="Delete site and energy references" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPendingEnergyDelete}">
              <Button Content="Confirm energy-reference delete"
                      Command="{Binding ConfirmEnergyDeleteCommand}"
                      automation:AutomationProperties.Name="Confirm energy-reference delete" />
              <Button Content="Cancel"
                      Command="{Binding CancelEnergyDeleteCommand}"
                      automation:AutomationProperties.Name="Cancel energy-reference delete" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <CheckBox Content="Show P1 preview"
                IsChecked="{Binding ShowP1Preview, Mode=TwoWay}"
                automation:AutomationProperties.Name="Toggle P1 preview" />
      <StackPanel Spacing="6" IsVisible="{Binding ShowP1Preview}">
        <TextBlock Text="{Binding PreviewStatus}" FontWeight="SemiBold"
                   automation:AutomationProperties.Name="P1 preview status" />

        <TextBlock Text="This site's orbit" FontWeight="SemiBold" />
        <ListBox ItemsSource="{Binding OrbitRows}"
                 MaxHeight="160"
                 automation:AutomationProperties.Name="P1 orbit rows">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SiteOrbitRowViewModel">
              <Grid ColumnDefinitions="70,90,150,*" ColumnSpacing="6">
                <TextBlock Text="{Binding P}" />
                <TextBlock Grid.Column="1" Text="{Binding OrbitMemberIndex}" />
                <TextBlock Grid.Column="2" Text="{Binding FractionalText}" />
                <TextBlock Grid.Column="3" Text="{Binding CartesianText}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Whole structure (canonical P order)" FontWeight="SemiBold" />
        <ListBox ItemsSource="{Binding WholeStructureRows}"
                 MaxHeight="180"
                 automation:AutomationProperties.Name="P1 whole-structure rows">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SiteWholeStructureRowViewModel">
              <Grid ColumnDefinitions="60,150,170,150,100" ColumnSpacing="6">
                <TextBlock Text="{Binding P}" />
                <TextBlock Grid.Column="1" Text="{Binding FractionalText}" />
                <TextBlock Grid.Column="2" Text="{Binding CartesianText}" />
                <TextBlock Grid.Column="3" Text="{Binding SiteName}" />
                <TextBlock Grid.Column="4" Text="{Binding Stability}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Plane" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding PlaneChoices}"
                    SelectedItem="{Binding SelectedPlane, Mode=TwoWay}"
                    automation:AutomationProperties.Name="P1 projection plane" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource Mocassin.BorderBrush}"
                BorderThickness="{DynamicResource Mocassin.BorderThickness}"
                Width="300"
                Height="300">
          <ItemsControl ItemsSource="{Binding ProjectionPoints}"
                        Width="300"
                        Height="300"
                        automation:AutomationProperties.Name="P1 projection">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas Width="300" Height="300" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SiteProjectionPointViewModel">
                <Ellipse Width="6" Height="6"
                         Fill="{DynamicResource Mocassin.AccentBrush}"
                         Canvas.Left="{Binding X}"
                         Canvas.Top="{Binding Y}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
