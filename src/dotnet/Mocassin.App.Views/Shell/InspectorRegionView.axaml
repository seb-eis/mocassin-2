<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Shell"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Shell.InspectorRegionView"
             x:DataType="vm:ShellViewModel">
  <Border Classes="region-card"
          automation:AutomationProperties.Name="Inspector panel">
    <Grid RowDefinitions="Auto,*">
      <TextBlock Text="Inspector"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Mocassin.ForegroundStrongBrush}"
                 Margin="{DynamicResource Mocassin.RegionHeaderPadding}" />
      <TextBlock Grid.Row="1"
                 Text="Nothing is selected."
                 TextWrapping="Wrap"
                 Classes="caption"
                 Margin="{DynamicResource Mocassin.RegionPadding}"
                 IsVisible="{Binding !HasInspectorContent}" />
      <ContentControl Grid.Row="1"
                      Content="{Binding InspectorContent}"
                      IsVisible="{Binding HasInspectorContent}"
                      Margin="{DynamicResource Mocassin.RegionPadding}" />
    </Grid>
  </Border>
</UserControl>
