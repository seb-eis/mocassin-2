<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Shell"
             x:Class="Mocassin.App.Views.Shell.StatusBarView"
             x:DataType="vm:ShellViewModel">
  <Border Background="{DynamicResource Mocassin.StatusBarBackground}"
          Padding="12,2"
          MinHeight="{DynamicResource Mocassin.StatusBarHeight}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Text="{Binding StatusBar.ApplicationName}"
                 FontWeight="SemiBold"
                 FontSize="{DynamicResource Mocassin.CaptionFontSize}"
                 Foreground="{DynamicResource Mocassin.StatusBarForeground}"
                 VerticalAlignment="Center"
                 Margin="0,0,16,0" />
      <ItemsControl Grid.Column="1" ItemsSource="{Binding StatusBar.Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="16" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StatusBarItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Binding Glyph}"
                         FontSize="{DynamicResource Mocassin.CaptionFontSize}"
                         Foreground="{DynamicResource Mocassin.StatusBarForeground}" />
              <TextBlock Text="{Binding Text}"
                         ToolTip.Tip="{Binding ToolTip}"
                         FontSize="{DynamicResource Mocassin.CaptionFontSize}"
                         Foreground="{DynamicResource Mocassin.StatusBarForeground}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ProgressBar Grid.Column="2"
                   Width="140"
                   Margin="16,2,0,2"
                   Height="4"
                   Minimum="0"
                   Maximum="1"
                   Value="{Binding Progress.Fraction, TargetNullValue=0}"
                   IsIndeterminate="{Binding Progress.IsIndeterminate}"
                   Background="Transparent"
                   Foreground="{DynamicResource Mocassin.StatusBarForeground}"
                   IsVisible="{Binding Progress.IsActive}" />
    </Grid>
  </Border>
</UserControl>
