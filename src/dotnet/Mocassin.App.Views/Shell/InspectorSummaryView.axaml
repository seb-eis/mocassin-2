<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Shell"
             x:Class="Mocassin.App.Views.Shell.InspectorSummaryView"
             x:DataType="vm:InspectorSummaryViewModel">
  <StackPanel Spacing="6">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding Details}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <TextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
