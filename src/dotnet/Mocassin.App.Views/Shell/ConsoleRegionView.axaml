<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Shell"
             xmlns:consoles="using:Mocassin.App.Views.Consoles"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Shell.ConsoleRegionView"
             x:DataType="vm:ShellViewModel">
  <Border Classes="region-card"
          automation:AutomationProperties.Name="Console panel">
    <consoles:ConsoleView DataContext="{Binding Console}" />
  </Border>
</UserControl>
