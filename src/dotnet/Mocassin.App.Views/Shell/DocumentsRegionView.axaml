<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Shell"
             xmlns:documents="using:Mocassin.App.ViewModels.Documents"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Shell.DocumentsRegionView"
             x:DataType="vm:ShellViewModel">
  <Border Classes="region-card"
          automation:AutomationProperties.Name="Documents panel">
    <TabControl automation:AutomationProperties.Name="Document tabs"
                ItemsSource="{Binding Documents.Documents}"
                SelectedItem="{Binding Documents.ActiveDocument}"
                TabStripPlacement="Top">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="documents:DocumentViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ContentControl Name="TabIconSlot"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Content="{Binding Icon}"
                            IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                            IsHitTestVisible="False"
                            Focusable="False"
                            automation:AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding ToolTip}" VerticalAlignment="Center" />
            <TextBlock Text="*"
                       IsVisible="{Binding IsDirty}"
                       automation:AutomationProperties.Name="Unsaved changes"
                       VerticalAlignment="Center"
                       FontWeight="Bold" />
            <Button Content="×"
                    automation:AutomationProperties.Name="Close document"
                    Command="{Binding CloseCommand}"
                    Classes="compact"
                    FontSize="{DynamicResource Mocassin.CaptionFontSize}"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip.Tip="Close document" />
            <StackPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Close" Command="{Binding CloseCommand}" />
                <MenuItem Header="Close Others" Command="{Binding CloseOthersCommand}" />
                <MenuItem Header="Close All" Command="{Binding CloseAllCommand}" />
              </ContextMenu>
            </StackPanel.ContextMenu>
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
    </TabControl>
  </Border>
</UserControl>
