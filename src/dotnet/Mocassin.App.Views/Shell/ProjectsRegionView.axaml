<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mocassin.App.ViewModels.Shell"
             xmlns:projects="using:Mocassin.App.ViewModels.Projects"
             xmlns:navigation="using:Mocassin.App.ViewModels.Navigation"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Shell.ProjectsRegionView"
             x:DataType="vm:ShellViewModel">
  <Border Classes="region-card"
          automation:AutomationProperties.Name="Projects panel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock Text="Projects"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Mocassin.ForegroundStrongBrush}"
                 Margin="{DynamicResource Mocassin.RegionHeaderPadding}" />
      <ListBox Grid.Row="1"
               Classes="scroll-gutter-right"
               automation:AutomationProperties.Name="Open projects"
               ItemsSource="{Binding Workspace.ProjectsInternal}"
               SelectedItem="{Binding Workspace.ActiveProject}"
               MaxHeight="180"
               Background="Transparent"
               BorderThickness="0"
               Margin="4,0,4,8">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="projects:ProjectWorkspaceEntry">
            <Grid ColumnDefinitions="Auto,*">
              <ContentControl Name="ProjectRowIconSlot"
                              Width="{DynamicResource Mocassin.IconSize}"
                              Height="{DynamicResource Mocassin.IconSize}"
                              Margin="0,0,4,0"
                              VerticalAlignment="Center"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              Content="{Binding Icon}"
                              IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                              IsHitTestVisible="False"
                              Focusable="False"
                              automation:AutomationProperties.AccessibilityView="Raw" />
              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="*"
                             IsVisible="{Binding IsDirty}"
                             automation:AutomationProperties.Name="Unsaved changes"
                             FontWeight="Bold" />
                </StackPanel>
                <TextBlock Text="{Binding Path}"
                           Classes="caption"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding LockStateText}" Classes="caption" />
                  <TextBlock Text="{Binding LastDocumentTitle}" Classes="caption" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="2"
                 Text="Explorer"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Mocassin.ForegroundStrongBrush}"
                 Margin="{DynamicResource Mocassin.RegionHeaderPadding}" />
      <TreeView Grid.Row="3"
                Classes="scroll-gutter-both"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                automation:AutomationProperties.Name="Project explorer"
                x:Name="ExplorerTree"
                ItemsSource="{Binding Explorer.Nodes}"
                SelectedItem="{Binding Explorer.SelectedNode}"
                Background="Transparent"
                BorderThickness="0"
                Margin="4,0"
                DoubleTapped="OnExplorerDoubleTapped">
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="navigation:ExplorerNode" ItemsSource="{Binding ChildNodes}">
            <Grid ColumnDefinitions="Auto,*">
              <ContentControl Name="NodeIconSlot"
                              Width="{DynamicResource Mocassin.IconSize}"
                              Height="{DynamicResource Mocassin.IconSize}"
                              Margin="0,0,4,0"
                              VerticalAlignment="Center"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              Content="{Binding Icon}"
                              IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                              IsHitTestVisible="False"
                              Focusable="False"
                              automation:AutomationProperties.AccessibilityView="Raw" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Label}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <Button Grid.Row="4"
              automation:AutomationProperties.Name="Open selected project node"
              Content="Open selected"
              Command="{Binding Explorer.OpenSelectedCommand}"
              HorizontalAlignment="Left"
              Margin="12,8,12,12" />
    </Grid>
  </Border>
</UserControl>
