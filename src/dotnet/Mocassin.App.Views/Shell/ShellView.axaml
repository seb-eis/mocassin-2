<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Mocassin.App.Views.Shell"
             xmlns:vm="using:Mocassin.App.ViewModels.Shell"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Shell.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource Mocassin.ChromeBackground}">
    <Menu Grid.Row="0" x:Name="MainMenu" automation:AutomationProperties.Name="Main menu" />

    <Border Grid.Row="1"
            Classes="banner-warning"
            BorderThickness="0,0,0,1"
            Padding="12,6"
            IsVisible="{Binding ReadOnlyBannerText, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="⚠"
                   Foreground="{DynamicResource Mocassin.WarningForeground}"
                   automation:AutomationProperties.Name="Read-only warning" />
        <TextBlock Text="{Binding ReadOnlyBannerText}"
                   Foreground="{DynamicResource Mocassin.ForegroundStrongBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2"
          x:Name="WorkspaceGrid"
          Margin="{DynamicResource Mocassin.RegionGap}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="160" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="160" />
      </Grid.ColumnDefinitions>

      <shell:ProjectsRegionView Grid.Column="0"
                                x:Name="ProjectsRegion"
                                IsVisible="{Binding Regions.IsProjectsVisible}" />
      <GridSplitter Grid.Column="1"
                    x:Name="ProjectsSplitter"
                    Width="6"
                    ResizeDirection="Columns"
                    KeyboardIncrement="16"
                    Focusable="True"
                    IsVisible="{Binding Regions.IsProjectsVisible}"
                    automation:AutomationProperties.Name="Resize projects panel"
                    automation:AutomationProperties.HelpText="Use the arrow keys to resize the projects panel">
        <GridSplitter.FocusAdorner>
          <Template>
            <Border BorderBrush="{DynamicResource Mocassin.FocusBrush}"
                    BorderThickness="{DynamicResource Mocassin.FocusThickness}"
                    CornerRadius="1" />
          </Template>
        </GridSplitter.FocusAdorner>
      </GridSplitter>

      <Grid Grid.Column="2" x:Name="CentreGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="200" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="80" />
        </Grid.RowDefinitions>
        <shell:DocumentsRegionView Grid.Row="0" x:Name="DocumentsRegion" />
        <GridSplitter Grid.Row="1"
                      x:Name="ConsoleSplitter"
                      Height="6"
                      ResizeDirection="Rows"
                      KeyboardIncrement="16"
                      Focusable="True"
                      IsVisible="{Binding Regions.IsConsoleVisible}"
                      automation:AutomationProperties.Name="Resize console"
                      automation:AutomationProperties.HelpText="Use the arrow keys to resize the console">
          <GridSplitter.FocusAdorner>
            <Template>
              <Border BorderBrush="{DynamicResource Mocassin.FocusBrush}"
                      BorderThickness="{DynamicResource Mocassin.FocusThickness}"
                      CornerRadius="1" />
            </Template>
          </GridSplitter.FocusAdorner>
        </GridSplitter>
        <shell:ConsoleRegionView Grid.Row="2"
                                 x:Name="ConsoleRegion"
                                 IsVisible="{Binding Regions.IsConsoleVisible}" />
      </Grid>

      <GridSplitter Grid.Column="3"
                    x:Name="InspectorSplitter"
                    Width="6"
                    ResizeDirection="Columns"
                    KeyboardIncrement="16"
                    Focusable="True"
                    IsVisible="{Binding Regions.IsInspectorVisible}"
                    automation:AutomationProperties.Name="Resize inspector panel"
                    automation:AutomationProperties.HelpText="Use the arrow keys to resize the inspector panel">
        <GridSplitter.FocusAdorner>
          <Template>
            <Border BorderBrush="{DynamicResource Mocassin.FocusBrush}"
                    BorderThickness="{DynamicResource Mocassin.FocusThickness}"
                    CornerRadius="1" />
          </Template>
        </GridSplitter.FocusAdorner>
      </GridSplitter>
      <shell:InspectorRegionView Grid.Column="4"
                                 x:Name="InspectorRegion"
                                 IsVisible="{Binding Regions.IsInspectorVisible}" />
    </Grid>

    <shell:StatusBarView Grid.Row="3" />
  </Grid>
</UserControl>
