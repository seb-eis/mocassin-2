<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Mocassin.App.Views.Shell"
             xmlns:vm="using:Mocassin.App.ViewModels.Shell"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Mocassin.App.Views.Shell.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource Mocassin.ShellBackground}">
    <Menu Grid.Row="0" x:Name="MainMenu" automation:AutomationProperties.Name="Main menu" />

    <Border Grid.Row="1"
            Background="#FFF3CD"
            BorderBrush="#E0A800"
            BorderThickness="0,0,0,1"
            Padding="12,6"
            IsVisible="{Binding ReadOnlyBannerText, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding ReadOnlyBannerText}" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
      <shell:ProjectsRegionView Grid.Column="0"
                                Width="{Binding Regions.LeftWidth}"
                                IsVisible="{Binding Regions.IsProjectsVisible}" />
      <GridSplitter Grid.Column="1"
                    Width="4"
                    ResizeDirection="Columns"
                    IsVisible="{Binding Regions.IsProjectsVisible}" />

      <Grid Grid.Column="2" RowDefinitions="*,Auto,Auto">
        <shell:DocumentsRegionView Grid.Row="0" />
        <GridSplitter Grid.Row="1"
                      Height="4"
                      ResizeDirection="Rows"
                      IsVisible="{Binding Regions.IsConsoleVisible}" />
        <shell:ConsoleRegionView Grid.Row="2"
                                 Height="{Binding Regions.ConsoleHeight}"
                                 IsVisible="{Binding Regions.IsConsoleVisible}" />
      </Grid>

      <GridSplitter Grid.Column="3"
                    Width="4"
                    ResizeDirection="Columns"
                    IsVisible="{Binding Regions.IsInspectorVisible}" />
      <shell:InspectorRegionView Grid.Column="4"
                                 Width="{Binding Regions.RightWidth}"
                                 IsVisible="{Binding Regions.IsInspectorVisible}" />
    </Grid>

    <shell:StatusBarView Grid.Row="3" />
  </Grid>
</UserControl>
