<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Mocassin.App.Views.Shell"
             xmlns:vm="using:Mocassin.App.ViewModels.Shell"
             x:Class="Mocassin.App.Views.Shell.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <Menu Grid.Row="0" x:Name="MainMenu" />

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
      <shell:ProjectsRegionView Grid.Column="0"
                                Width="260"
                                IsVisible="{Binding Regions.IsProjectsVisible}" />
      <GridSplitter Grid.Column="1"
                    Width="4"
                    ResizeDirection="Columns"
                    IsVisible="{Binding Regions.IsProjectsVisible}" />

      <Grid Grid.Column="2" RowDefinitions="*,Auto,Auto">
        <shell:DocumentsRegionView Grid.Row="0" />
        <GridSplitter Grid.Row="1"
                      Height="4"
                      ResizeDirection="Rows"
                      IsVisible="{Binding Regions.IsConsoleVisible}" />
        <shell:ConsoleRegionView Grid.Row="2"
                                 Height="180"
                                 IsVisible="{Binding Regions.IsConsoleVisible}" />
      </Grid>

      <GridSplitter Grid.Column="3"
                    Width="4"
                    ResizeDirection="Columns"
                    IsVisible="{Binding Regions.IsInspectorVisible}" />
      <shell:InspectorRegionView Grid.Column="4"
                                 Width="320"
                                 IsVisible="{Binding Regions.IsInspectorVisible}" />
    </Grid>

    <shell:StatusBarView Grid.Row="2" />
  </Grid>
</UserControl>
