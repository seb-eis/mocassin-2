<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Mocassin.App.Views.Shell"
        xmlns:dialogs="using:Mocassin.App.Views.Dialogs"
        xmlns:notifications="using:Mocassin.App.Views.Notifications"
        xmlns:commands="using:Mocassin.App.Views.Commands"
        xmlns:settings="using:Mocassin.App.Views.Settings"
        xmlns:vm="using:Mocassin.App.ViewModels.Shell"
        x:Class="Mocassin.App.Views.Shell.ShellWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource Mocassin.ChromeBackground}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <shell:ShellView x:Name="ShellRoot" />
    <Grid x:Name="PaletteLayer" IsVisible="{Binding IsPaletteOpen}">
      <commands:CommandPaletteView x:Name="PaletteView" DataContext="{Binding Palette}" />
    </Grid>
    <Grid x:Name="CheatSheetLayer" IsVisible="{Binding IsCheatSheetOpen}">
      <commands:ShortcutCheatSheetView x:Name="CheatSheetView" DataContext="{Binding Shortcuts}" />
    </Grid>
    <Grid x:Name="SettingsLayer" IsVisible="{Binding Settings.IsOpen}">
      <settings:SettingsDialogView x:Name="SettingsView" DataContext="{Binding Settings}" />
    </Grid>
    <dialogs:DialogHost x:Name="DialogOverlay" />
    <notifications:NotificationHostView x:Name="NotificationOverlay"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="16" />
  </Grid>
</Window>
