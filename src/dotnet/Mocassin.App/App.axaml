<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mocassin.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Mocassin.App.Views/Themes/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <x:Double x:Key="Mocassin.FontScale">1</x:Double>
      <x:Double x:Key="Mocassin.DisplayFontSize">28</x:Double>
      <x:Double x:Key="Mocassin.TitleFontSize">20</x:Double>
      <x:Double x:Key="Mocassin.SubtitleFontSize">16</x:Double>
      <x:Double x:Key="Mocassin.BodyFontSize">14</x:Double>
      <x:Double x:Key="Mocassin.CaptionFontSize">12</x:Double>
      <x:Double x:Key="Mocassin.DisplayLineHeight">36</x:Double>
      <x:Double x:Key="Mocassin.TitleLineHeight">26</x:Double>
      <x:Double x:Key="Mocassin.SubtitleLineHeight">22</x:Double>
      <x:Double x:Key="Mocassin.BodyLineHeight">20</x:Double>
      <x:Double x:Key="Mocassin.CaptionLineHeight">16</x:Double>

      <Thickness x:Key="Mocassin.RegionGap">6</Thickness>
      <Thickness x:Key="Mocassin.RegionPadding">12</Thickness>
      <Thickness x:Key="Mocassin.RegionHeaderPadding">12,8</Thickness>
      <Thickness x:Key="Mocassin.CardPadding">16</Thickness>
      <Thickness x:Key="Mocassin.ControlPadding">8</Thickness>
      <x:Double x:Key="Mocassin.ControlMinHeight">34</x:Double>
      <Thickness x:Key="Mocassin.ItemPadding">4,2</Thickness>
      <Thickness x:Key="Mocassin.CompactButtonPadding">8,2</Thickness>
      <x:Double x:Key="Mocassin.CompactButtonMinHeight">26</x:Double>
      <x:Double x:Key="Mocassin.TabHeight">32</x:Double>
      <x:Double x:Key="Mocassin.MenuHeight">32</x:Double>
      <x:Double x:Key="Mocassin.StatusBarHeight">24</x:Double>

      <CornerRadius x:Key="Mocassin.RadiusCard">6</CornerRadius>
      <CornerRadius x:Key="Mocassin.RadiusControl">4</CornerRadius>
      <CornerRadius x:Key="Mocassin.RadiusTab">4</CornerRadius>
      <CornerRadius x:Key="Mocassin.RadiusTabTop">4,4,0,0</CornerRadius>
      <Thickness x:Key="Mocassin.BorderThickness">1</Thickness>
      <Thickness x:Key="Mocassin.ControlBorderThickness">1</Thickness>
      <Thickness x:Key="Mocassin.FocusThickness">2</Thickness>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Mocassin.App.Views/Styles/ShellStyles.axaml" />
  </Application.Styles>
</Application>
