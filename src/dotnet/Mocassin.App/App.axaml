<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mocassin.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <x:Double x:Key="Mocassin.BodyFontSize">14</x:Double>
    <x:Double x:Key="Mocassin.FontScale">1</x:Double>
    <x:String x:Key="Mocassin.Density">comfortable</x:String>
    <x:Boolean x:Key="Mocassin.HighContrast">False</x:Boolean>
    <x:Boolean x:Key="Mocassin.ReduceMotion">False</x:Boolean>
    <x:String x:Key="Mocassin.Accent">default</x:String>
    <Thickness x:Key="Mocassin.ControlPadding">8</Thickness>
    <Thickness x:Key="Mocassin.ItemPadding">4,2</Thickness>
    <x:Double x:Key="Mocassin.ControlMinHeight">34</x:Double>
    <x:Double x:Key="Mocassin.RowSpacing">6</x:Double>
    <Thickness x:Key="Mocassin.BorderThickness">1</Thickness>
    <SolidColorBrush x:Key="Mocassin.ShellBackground" Color="Transparent" />
    <SolidColorBrush x:Key="Mocassin.BorderBrush" Color="#33000000" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Mocassin.App.Views/Styles/ShellStyles.axaml" />
  </Application.Styles>
</Application>
