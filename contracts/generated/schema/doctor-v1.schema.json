{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mocassin.dev/schemas/doctor-v1.json",
  "title": "Doctor report",
  "description": "MOCASSIN contract manifest v1; generated from contracts/manifest.json.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "kind": {
      "type": "string",
      "enum": [
        "doctor"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "exitCode": {
      "type": "integer"
    },
    "summary": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "integer"
        },
        "warnings": {
          "type": "integer"
        },
        "infos": {
          "type": "integer"
        }
      },
      "required": [
        "errors",
        "warnings",
        "infos"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "domain": {
                "type": "string"
              },
              "objectId": {
                "type": "string"
              },
              "property": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "domain",
              "objectId"
            ],
            "additionalProperties": false
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "related": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "objectId": {
                  "type": "string"
                },
                "property": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "domain",
                "objectId"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "healthy": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "status",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "environment": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "framework": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "sqliteVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalogVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalogSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "solverPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "solverVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "framework",
        "os",
        "architecture",
        "sqliteVersion",
        "catalogVersion",
        "catalogSha256",
        "solverPath",
        "solverVersion"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "ok",
    "exitCode",
    "summary",
    "diagnostics",
    "healthy",
    "checks",
    "environment"
  ]
}
