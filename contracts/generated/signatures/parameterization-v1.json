{
  "manifestVersion": 1,
  "id": "parameterization",
  "domainPrefix": "mocassin/parameterization-signature/v1",
  "domainSeparator": "0x00",
  "hash": "sha256",
  "projectionType": "ParameterizationSignatureV1",
  "status": "final",
  "notes": "Final Step 09 parameterization projection: domain-separated six-field MessagePack array over the compiled-model signature and the dense applied values. Stable IDs, template metadata, set headers, sparse/unset markers, diagnostics, summaries, timings, and all runtime settings are excluded. Floats are float64 quantized to 12 decimals with round half away from zero; negative zero is normalized.",
  "fields": [
    {
      "name": "formatVersion",
      "type": "uint64",
      "required": true
    },
    {
      "name": "modelSignature",
      "type": "string",
      "required": true
    },
    {
      "name": "pairTables",
      "type": "array",
      "required": true,
      "items": "array",
      "itemItems": {
        "type": "array",
        "items": "float64"
      }
    },
    {
      "name": "groupSets",
      "type": "array",
      "required": true,
      "items": "array",
      "itemItems": {
        "type": "array",
        "items": "float64"
      }
    },
    {
      "name": "siteEnergies",
      "type": "array",
      "required": true,
      "items": "float64"
    },
    {
      "name": "transitionRules",
      "type": "array",
      "required": true,
      "items": "float64"
    }
  ]
}
